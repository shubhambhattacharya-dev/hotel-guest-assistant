HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
NODE_ENV=development

# Primary provider (tool calls + grounded answers + verbalization)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Fallback provider (used when the primary fails or is not configured)
GEMINI_API_KEY=your_actual_gemini_key
GEMINI_MODEL=gemini-3.6-flash

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://jp.cloud.langfuse.com"